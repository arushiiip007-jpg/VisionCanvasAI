# VisionCanvas AI — Environment Configuration Template
# Copy this file to .env and insert your real API credentials when required.
# DO NOT commit .env containing real keys to version control.

# Generative AI / Vision Language Model Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_VISION_MODEL=openai/gpt-4o-mini
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Optional Image Generation Provider
IMAGE_GEN_API_KEY=your_image_generation_api_key_here

# Application Configuration
APP_ENV=development
DEBUG=True
CAMERA_INDEX=0
DEFAULT_FRAME_WIDTH=640
DEFAULT_FRAME_HEIGHT=480
